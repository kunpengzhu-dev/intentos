{
  "name": "intentos",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev:backend": "pnpm --filter @intentos/backend dev",
    "check:backend": "pnpm --filter @intentos/backend check",
    "test:backend": "pnpm --filter @intentos/backend test",
    "dev:frontend": "pnpm --filter @intentos/frontend dev",
    "build:frontend": "pnpm --filter @intentos/frontend build",
    "check:frontend": "pnpm --filter @intentos/frontend check",
    "dev:desktop": "pnpm --filter @intentos/desktop dev",
    "build:desktop": "pnpm --filter @intentos/desktop build",
    "start:desktop": "pnpm --filter @intentos/desktop start",
    "check": "pnpm check:backend && pnpm check:frontend",
    "test": "pnpm test:backend"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
