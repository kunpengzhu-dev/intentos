PORT=3001
DATABASE_URL=./data/intentos.db
LOG_LEVEL=debug

BOOT_PROVIDER_COMMAND=node
BOOT_PROVIDER_ARGS_JSON=["./scripts/mock-boot-provider.mjs"]
BOOT_CALLBACK_BASE_URL=
BOOT_PROVIDER_TIMEOUT_MS=30000

AGENT_PROVIDER=openclaw
OPENCLAW_BASE_URL=http://localhost:8787
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_MS=300000

OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_CHAT_SESSION_KEY=intentos:global
OPENCLAW_CHAT_TIMEOUT_MS=300000

ARTIFACT_STORAGE_DIR=./data/artifacts
ARTIFACT_PREVIEW_MAX_BYTES=2097152
