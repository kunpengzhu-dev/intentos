# OpenClaw Gateway smoke / local development
OPENCLAW_GATEWAY_URL=ws://localhost:18789

# Gateway auth:
OPENCLAW_TOKEN=

# IntentOS backend
INTENTOS_BACKEND_HOST=localhost
INTENTOS_BACKEND_PORT=3030
INTENTOS_BACKEND_CORS_ORIGIN=*
INTENTOS_ORB_INTENT_KEY=agent:main:intentos:global
INTENTOS_HISTORY_LIMIT=100
INTENTOS_PREVIEW_LIMIT=6
INTENTOS_PREVIEW_MAX_CHARS=1200

# Frontend
VITE_BOOT_ALWAYS_SHOW=0
