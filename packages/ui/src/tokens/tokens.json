      "900": "#312E81"
    },
    "success": { "light": "#DCFCE7", "DEFAULT": "#22C55E", "dark": "#15803D" },
    "warning": { "light": "#FEF9C3", "DEFAULT": "#EAB308", "dark": "#A16207" },
    "error": { "light": "#FEE2E2", "DEFAULT": "#EF4444", "dark": "#B91C1C" },
    "info": { "light": "#DBEAFE", "DEFAULT": "#3B82F6", "dark": "#1D4ED8" },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F9FAFB",
      "100": "#F3F4F6",
      "200": "#E5E7EB",
      "300": "#D1D5DB",
